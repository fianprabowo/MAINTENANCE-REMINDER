# --- Opsional: stack lama Go + MySQL (docker-compose `backend` / `mysql`). ---
# Aplikasi Next.js di repo ini tidak memanggil API Go; data lewat Supabase dari browser.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=maintenance_reminder
MYSQL_USER=appuser
MYSQL_PASSWORD=apppassword
MYSQL_ROOT_PASSWORD=rootpassword

APP_PORT=8080
JWT_SECRET=change-me-to-a-strong-secret
JWT_EXPIRY_HOURS=72

# --- Frontend (wajib untuk mode Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Access gate — 1 user = 1 row in public.user_access_codes (column access_code). Frontend /api/access.
# Server-only; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

