# --- Supabase (wajib) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, dipakai route /api/access. Jangan expose ke browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Access gate (route /api/access) ---
# Shared secret yang user ketik di halaman akses
APP_ACCESS_CODE=your-access-code
# Satu Supabase user yang dipakai server untuk membuat session setelah code valid
APP_ACCESS_SUPABASE_EMAIL=shared-user@example.com
APP_ACCESS_SUPABASE_PASSWORD=strong-password-for-shared-user
